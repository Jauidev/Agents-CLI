<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Tema base Material 3, sin ActionBar (usamos WebView a pantalla completa).
      Dark-first: forzamos la paleta propia en claro y oscuro para tener identidad
      consistente (la terminal siempre es oscura).
    -->
    <style name="Theme.AgentTerminal" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Marca -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/bg_crust</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/bg_crust</item>

        <!-- Superficies / fondos -->
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_mantle</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/overlay</item>

        <!-- Barras del sistema a juego -->
        <item name="android:statusBarColor">@color/bg_crust</item>
        <item name="android:navigationBarColor">@color/bg_crust</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Pastilla del item seleccionado en la barra inferior. -->
    <style name="Nav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surface</item>
    </style>

    <!-- Launch theme: logo de marca mientras arranca el proceso. Se cambia al
         tema normal en MainActivity.onCreate (setTheme antes de super). -->
    <style name="Theme.AgentTerminal.Splash" parent="Theme.AgentTerminal">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- Gestor del entorno (D2): títulos de sección y botones de acción. -->
    <style name="EnvSectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="EnvAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
