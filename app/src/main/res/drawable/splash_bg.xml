<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de arranque: color de marca + logo centrado (compatible con todas
     las versiones vía windowBackground de la launch theme). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg_base" />
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
