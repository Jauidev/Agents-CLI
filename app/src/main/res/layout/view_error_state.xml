<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de estado: preparación/instalación del entorno y errores de conexión.
  IDs estables (error_title/error_message/btn_bootstrap/btn_retry) usados por
  MainActivity; install_progress se muestra solo durante la instalación.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/status_logo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@color/bg_mantle"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/error_title"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <ProgressBar
        android:id="@+id/install_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:text="@string/error_instructions"
        android:textColor="@color/text_dim"
        android:textSize="15sp"
        android:gravity="top|start"
        android:scrollbars="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bootstrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_bootstrap" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_retry" />

</LinearLayout>
