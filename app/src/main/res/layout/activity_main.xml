<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cabecera: selector de CLI (arriba a la izquierda) + carpeta + volver. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_mantle"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botones para elegir el CLI (se crean en MainActivity). -->
        <LinearLayout
            android:id="@+id/cli_selector"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/header_folder"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:drawableStart="@drawable/ic_folder"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_dim"
            tools:text="Test Ia" />

        <TextView
            android:id="@+id/header_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/back_to_projects"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Contenedor de contenido: entre la cabecera y la fila de teclas. -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/key_bar">

        <!-- WebView = la terminal (xterm.js servido por ttyd). -->
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay de error: se muestra si ttyd no responde. -->
        <include
            android:id="@+id/error_state"
            layout="@layout/view_error_state"
            android:visibility="gone" />

        <!-- Barra de progreso mientras carga la sesión. -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Fila de teclas especiales para las TUIs (Esc/Tab/flechas...).
         Botones grandes; se crean en MainActivity. -->
    <HorizontalScrollView
        android:id="@+id/key_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/bg_mantle"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/key_bar_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
